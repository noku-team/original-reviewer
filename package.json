{
  "name": "original-reviewer",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "bun src/server.ts",
    "start": "bun src/server.ts",
    "release": "release-it",
    "deploy": "./scripts/deploy.sh"
  },
  "release-it": {
    "git": {
      "requireBranch": "main",
      "commitMessage": "chore(release): v${version}",
      "tagName": "v${version}"
    },
    "hooks": {
      "after:release": "echo -n \"v${version}\" > .CI_VERSION"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": "angular"
      }
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@release-it/conventional-changelog": "10.0.5",
    "@types/bun": "^1.3.0",
    "@types/minimatch": "^5.1.2",
    "eslint": "^9.37.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "release-it": "19.2.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "@octokit/app": "^16.1.4",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "minimatch": "^10.2.6",
    "yaml": "^2.9.1"
  }
}
