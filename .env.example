# GitHub App (https://github.com/settings/apps)
GITHUB_APP_ID=
# Double-quoted PEM. Real newlines, or a single line with \n.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
-----END RSA PRIVATE KEY-----
"
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=original-reviewer

# Original inference (https://ai.original.land)
ORIGINAL_API_BASE=https://ai-api.original.land
ORIGINAL_BOT_ID=

# Self-host: set the API key and skip /connect
ORIGINAL_API_KEY=

# Hosted: leave ORIGINAL_API_KEY empty. Register a public OAuth client, then:
#   POST https://ai.original.land/oauth/register
ORIGINAL_CONNECT_AUTHORIZE_URL=https://ai.original.land/oauth/authorize
ORIGINAL_CONNECT_TOKEN_URL=https://ai.original.land/oauth/token
ORIGINAL_CONNECT_CLIENT_ID=
ORIGINAL_CONNECT_REDIRECT_URI=https://please-comic-casa-essential.trycloudflare.com/connect/callback
# Trailing `agent.chat:` is filled with ORIGINAL_BOT_ID. Bare `agent.chat:` 400s on authorize.
ORIGINAL_CONNECT_SCOPE=openid agent.chat:

# Optional
PORT=3000
# Queue + Connect tokens. Unset = memory (lost on restart).
# REDIS_URL=redis://127.0.0.1:6379
