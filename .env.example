# GitHub App (https://github.com/settings/apps)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=original-reviewer

# Original inference (https://ai.original.land)
ORIGINAL_API_BASE=https://ai-api.original.land
ORIGINAL_BOT_ID=

# Self-host: set the API key and skip /connect
ORIGINAL_API_KEY=

# Hosted: Original Connect (leave ORIGINAL_API_KEY empty)
ORIGINAL_CONNECT_AUTHORIZE_URL=
ORIGINAL_CONNECT_TOKEN_URL=

# Optional
PORT=3000
# REDIS_URL=redis://127.0.0.1:6379
